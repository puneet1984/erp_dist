function checkDuplicate($field, $value, $conn)
{
	if (empty($value)) {
		return false;
	}

	// Special handling for name+contact combo
	if ($field === 'name_contact') {
		$stmt = $conn->prepare("SELECT patient_id, name, age, gender, contact, 
							   aadhar_number, abha_id, ayushmaan_id 
							   FROM patients 
							   WHERE name = ? AND contact = ?");
		$stmt->bind_param('ss', $value['name'], $value['contact']);
	} else {
		$stmt = $conn->prepare("SELECT patient_id, name, age, gender, contact, 
							   aadhar_number, abha_id, ayushmaan_id 
							   FROM patients 
							   WHERE {$field} = ?");
		$stmt->bind_param('s', $value);
	}
	
	$stmt->execute();
	return $stmt->get_result()->fetch_assoc();
}

if ('POST' === $_SERVER['REQUEST_METHOD']) {
	$conn = getDbConnection();
	$conn->begin_transaction();

	try {
		// Lock the table for ID generation
		$conn->query('LOCK TABLES patients WRITE');

		// Get next ID - Changed to handle BIGINT properly
		$stmt = $conn->prepare('SELECT MAX(patient_id) as max_id FROM patients FOR UPDATE');
		$stmt->execute();
		$result = $stmt->get_result()->fetch_assoc();
		$next_id = ($result['max_id'] ?? 0) + 1; // Now storing as number, not padded string

		$errors = [];

		// Sanitize and validate inputs
		$firstName = capitalizeWords(sanitizeInput($_POST['first_name']));
		$middleName = capitalizeWords(sanitizeInput($_POST['middle_name']));
		$relation = sanitizeInput($_POST['relation']);
		$lastName = capitalizeWords(sanitizeInput($_POST['last_name']));

		// Format full name
		$name = $firstName;
		if ($middleName) {
			$name .= " {$relation} {$middleName}";
		}
		if ($lastName) {
			$name .= " {$lastName}";
		}

		$age = sanitizeInput($_POST['age']);
		$gender = sanitizeInput($_POST['gender']);
		$contact = sanitizeInput($_POST['contact']);
		$address = sanitizeInput($_POST['address']);
		$city = capitalizeWords(sanitizeInput($_POST['city']));
		$payment_type_id = (int) $_POST['payment_type_id']; // Changed from payment_type
		$aadhar = sanitizeInput($_POST['aadhar_number'] ?? '');
		$abha = sanitizeInput($_POST['abha_id'] ?? '');
		$ayushmaan = sanitizeInput($_POST['ayushmaan_id'] ?? '');
		$company_name = (2 === $payment_type_id) ? capitalizeWords(sanitizeInput($_POST['company_name'])) : null; // 2 is COMPANY_CREDIT

		// Validation checks
		if (empty($name)) {
			$errors[] = 'Name is required';
		}

		if (!validateAge($age)) {
			$errors[] = 'Invalid age';
		}

		if (!validateMobile($contact)) {
			$errors[] = 'Invalid mobile number (must be 10 digits starting with 6-9)';
		}

		// Additional validations
		if (!empty($aadhar) && !validateAadhar($aadhar)) {
			$errors[] = 'Invalid Aadhar number';
		}
		if (!empty($abha) && !validateAbha($abha)) {
			$errors[] = 'Invalid ABHA ID';
		}
		if (!empty($ayushmaan) && !validateAyushmaan($ayushmaan)) {
			$errors[] = 'Invalid Ayushmaan ID';
		}

		if (!empty($errors)) {
			echo json_encode(['status' => 'error', 'message' => implode(', ', $errors)]);
			exit;
		}

		// Check for duplicates
		$duplicate = false;
		$duplicate_data = [];

		// Check name + contact combination first
		if ($found = checkDuplicate('name_contact', ['name' => $name, 'contact' => $contact], $conn)) {
			$duplicate = true;
			$duplicate_data['name_contact'] = $found;
		}

		if (!empty($aadhar)) {
			if ($found = checkDuplicate('aadhar_number', $aadhar, $conn)) {
				$duplicate = true;
				$duplicate_data['aadhar'] = $found;
			}
		}

		if (!empty($abha)) {
			if ($found = checkDuplicate('abha_id', $abha, $conn)) {
				$duplicate = true;
				$duplicate_data['abha'] = $found;
			}
		}

		if (!empty($ayushmaan)) {
			if ($found = checkDuplicate('ayushmaan_id', $ayushmaan, $conn)) {
				$duplicate = true;
				$duplicate_data['ayushmaan'] = $found;
			}
		}

		if ($duplicate) {
			echo json_encode([
				'status' => 'duplicate',
				'message' => 'Duplicate records found',
				'data' => $duplicate_data,
			]);
			exit;
		}

		// // Handle company account if payment type is COMPANY_CREDIT
		// if (2 === $payment_type_id) { // COMPANY_CREDIT
		//     // Check if new company
		//     if (isset($_POST['new_company_name']) && !empty($_POST['new_company_name'])) {
		//         $company_name = sanitizeInput($_POST['new_company_name']);

		//         // Create new company account with default terms
		//         $stmt = $conn->prepare("INSERT INTO company_accounts 
		//             (company_name, credit_limit, payment_days, status) 
		//             VALUES (?, 50000, 30, 'ACTIVE')
		//             ON DUPLICATE KEY UPDATE company_name = VALUES(company_name)");

		//         $stmt->bind_param('s', $company_name);
		//         $stmt->execute();
		//     } else {
		//         $company_name = sanitizeInput($_POST['company_name']);

		//         // Verify company exists
		//         $stmt = $conn->prepare('SELECT company_id, status FROM company_accounts WHERE company_name = ?');
		//         $stmt->bind_param('s', $company_name);
		//         $stmt->execute();
		//         $company = $stmt->get_result()->fetch_assoc();

		//         if (!$company) {
		//             // Auto-create company if doesn't exist
		//             $stmt = $conn->prepare("INSERT INTO company_accounts 
		//                 (company_name, credit_limit, payment_days, status) 
		//                 VALUES (?, 50000, 30, 'ACTIVE')");

		//             $stmt->bind_param('s', $company_name);
		//             $stmt->execute();
		//         } elseif ('ACTIVE' !== $company['status']) {
		//             throw new Exception('Company account is '.$company['status']);
		//         }
		//     }
		// }

		// Prepare empty values to pass by reference
		$aadhar_val = !empty($aadhar) ? $aadhar : null;
		$abha_val = !empty($abha) ? $abha : null;
		$ayushmaan_val = !empty($ayushmaan) ? $ayushmaan : null;

		$stmt = $conn->prepare('INSERT INTO patients (
            patient_id, name, age, gender, contact, address, city, state,
            payment_type_id, company_name, aadhar_number, abha_id, ayushmaan_id
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)');

		$stmt->bind_param(
			'isisssssissss',
			$next_id,
			$name,
			$age,
			$gender,
			$contact,
			$address,
			$city,    // New field
			$_POST['state'],   // New field
			$payment_type_id,
			$company_name,
			$aadhar_val,
			$abha_val,
			$ayushmaan_val
		);

		if ($stmt->execute()) {
			// Get next available ID after insertion (simplified)
			$stmt = $conn->prepare('SELECT MAX(CAST(patient_id AS UNSIGNED)) as max_id FROM patients');
			$stmt->execute();
			$result = $stmt->get_result()->fetch_assoc();
			$next_available_id = ($result['max_id'] ?? 0) + 1; // Now storing as number, not padded string

			$conn->commit();
			$conn->query('UNLOCK TABLES');
			echo json_encode([
				'status' => 'success',
				'patient_id' => $next_id, // Sending as number
				'next_patient_id' => $next_available_id, // Now receiving as number, not padded string
			]);
		} else {
			throw new Exception($conn->error);
		}

	} catch (Exception $e) {
		$conn->rollback();
		$conn->query('UNLOCK TABLES');
		echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
	} finally {
		// Ensure tables are unlocked even if there's an error
		$conn->query('UNLOCK TABLES');
	}
	exit;
}

$conn = getDbConnection();
$stmt = $conn->prepare('SELECT MAX(patient_id) as max_id FROM patients');
$stmt->execute();
$result = $stmt->get_result()->fetch_assoc();
$initial_next_id = ($result['max_id'] ?? 0) + 1; // Store as number

// Modify the company dropdown to fetch from company_accounts table
$companies = $conn->query("SELECT company_name, status 
                          FROM company_accounts 
                          WHERE status = 'ACTIVE' 
                          ORDER BY company_name");

// After the company query, add insurance providers query
