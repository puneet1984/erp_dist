<?php
define('SECURE_ACCESS', true);
require_once '../../includes/core.php';

// Check billing permissions
if (!checkPermission('bills', 'create')) {
    header('Location: /hospital/modules/auth/unauthorized.php');
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $conn = getDbConnection();
    $patient_id = $_POST['patient_id'];
    $bill_id = generateHospitalBillId($patient_id, $conn);
    $services = json_decode($_POST['services'], true);

    // Start transaction
    $conn->begin_transaction();

    try {
        // Insert main bill
        $stmt = $conn->prepare("INSERT INTO bills (bill_id, bill_date, patient_id, doctor_id, dept_id, 
                               total_amount, discount, final_amount, payment_status, payment_type_id) 
                               VALUES (?, CURDATE(), ?, ?, ?, ?, ?, ?, ?, ?)");

        $total = array_sum(array_column($services, 'total'));
        $discount = isset($_POST['discount']) ? $_POST['discount'] : 0;
        $final = $total - $discount;
        $payment_type_id = $_POST['payment_type_id'];
        $status = 'PENDING';

        $stmt->bind_param(
            "ssiidddsi",
            $bill_id,
            $patient_id,
            $_POST['doctor_id'],
            $_POST['dept_id'],
            $total,
            $discount,
            $final,
            $status,
            $payment_type_id
        );
        $stmt->execute();

        // Insert bill items
        $stmt = $conn->prepare("INSERT INTO bill_items (bill_id, service_id, quantity, unit_price, total) 
                               VALUES (?, ?, ?, ?, ?)");

        foreach ($services as $service) {
            $stmt->bind_param(
                "siids",
                $bill_id,
                $service['service_id'],
                $service['quantity'],
                $service['price'],
                $service['total']
            );
            $stmt->execute();
        }

        $conn->commit();
        echo json_encode(['status' => 'success', 'bill_id' => $bill_id]);

    } catch (Exception $e) {
        $conn->rollback();
        echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
    }
    exit;
}

$conn = getDbConnection();
// Modify the doctors query to include charge_per_visit
$doctors = $conn->query("SELECT d.*, dept.name as dept_name 
                        FROM doctors d 
                        JOIN departments dept ON d.dept_id = dept.dept_id 
                        WHERE d.status = 'ACTIVE' 
                        ORDER BY d.name")->fetch_all(MYSQLI_ASSOC);

?>
